# shellcheck shell=bash

use flake
dotenv_if_exists

case "$(uname -s)" in
  Darwin)
    # `podman-create` stops any rival machine, so at most one ever runs.
    # Watching the machine directory is what reloads direnv once one is created
    # or removed; `machine list` and `inspect` only read it, so this cannot loop.
    watch_dir "${XDG_CONFIG_HOME:-$HOME/.config}/containers/podman/machine"
    podman_first_machine() {
      env -u CONTAINER_CONNECTION -u CONTAINER_HOST \
        podman machine list --format "$1" 2>/dev/null |
        # `machine list` appends `*` to the default machine's `Name`.
        sed -e 's/\*$//' -e '/^$/d' | head -n1
    }
    podman_machine="$(podman_first_machine '{{if .Running}}{{.Name}}{{end}}')"
    [ -n "$podman_machine" ] || podman_machine="$(podman_first_machine '{{.Name}}')"
    podman_info="$(
      env -u CONTAINER_CONNECTION -u CONTAINER_HOST \
        podman machine inspect "$podman_machine" \
        --format '{{.Rootful}} {{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null || true
    )"
    unset -f podman_first_machine
    PODMAN_SOCKET="${podman_info#* }"
    export PODMAN_MACHINE="$podman_machine"
    export PODMAN_SOCKET
    unset CONTAINER_HOST DOCKER_HOST DOCKER_MACHINE_NAME
    # A stale CONTAINER_CONNECTION or DOCKER_CONTEXT makes every podman and
    # docker command fail outright, completion included, since podman rejects
    # the connection before dispatching the subcommand.
    if [ -n "$PODMAN_SOCKET" ]; then
      if [ "${podman_info%% *}" = true ]; then
        export CONTAINER_CONNECTION="$podman_machine-root"
      else
        export CONTAINER_CONNECTION="$podman_machine"
      fi
      export DOCKER_CONTEXT="$podman_machine"
    else
      unset CONTAINER_CONNECTION DOCKER_CONTEXT
    fi
    unset podman_machine podman_info
    ;;
  Linux)
    unset PODMAN_MACHINE PODMAN_SOCKET CONTAINER_CONNECTION CONTAINER_HOST DOCKER_CONTEXT DOCKER_MACHINE_NAME
    export DOCKER_HOST="unix://${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
    ;;
esac
