# shellcheck shell=bash

use flake
dotenv_if_exists

podman_mode=rootless

case "$(uname -s)" in
  Darwin)
    case "$podman_mode" in
      rootless)
        export PODMAN_MACHINE=podman
        export CONTAINER_CONNECTION=podman
        ;;
      rootful)
        export PODMAN_MACHINE=podman-rootful
        export CONTAINER_CONNECTION=podman-rootful-root
        ;;
      *)
        echo "unsupported podman_mode: $podman_mode" >&2
        return 1
        ;;
    esac
    unset CONTAINER_HOST DOCKER_HOST DOCKER_MACHINE_NAME
    PODMAN_SOCKET="$(
      env -u CONTAINER_CONNECTION -u CONTAINER_HOST \
        podman machine inspect "$PODMAN_MACHINE" \
        --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null || true
    )"
    export PODMAN_SOCKET
    export DOCKER_CONTEXT="$PODMAN_MACHINE"
    ;;
  Linux)
    unset PODMAN_MACHINE PODMAN_SOCKET CONTAINER_CONNECTION CONTAINER_HOST DOCKER_CONTEXT DOCKER_MACHINE_NAME
    export DOCKER_HOST="unix://${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
    ;;
esac

unset podman_mode
